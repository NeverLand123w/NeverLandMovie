---
export const prerender = false;

const { id } = Astro.params;
const segments = id.split("/");
const episodeId = segments.pop();
const mediaId = segments.join("/");

const [infoRes, watchRes] = await Promise.all([
  fetch(`https://neverland-api.vercel.app/movies/flixhq/info?id=${mediaId}`),
  fetch(
    `https://neverland-api.vercel.app/movies/flixhq/watch?episodeId=${episodeId}&mediaId=${mediaId}&server=vidcloud`,
  ),
]);

const info = await infoRes.json();
const watchData = await watchRes.json();

const sourceUrl =
  watchData.sources?.find((s) => s.quality === "auto")?.url ||
  watchData.sources?.[0]?.url;
const apiReferer = watchData.headers?.Referer || "";

const playerSrc = sourceUrl
  ? `/api/proxy?url=${encodeURIComponent(sourceUrl)}&referer=${encodeURIComponent(apiReferer)}`
  : "";
const playerTitle = info.title || "Loading...";
const posterUrl = info.cover || info.image || "";
const playerPoster = posterUrl
  ? `/api/proxy?url=${encodeURIComponent(posterUrl)}&referer=${encodeURIComponent(apiReferer)}`
  : "";
const playerTracks =
  watchData.subtitles?.map((s) => ({
    kind: "captions",
    label: s.lang,
    src: s.url,
    srclang: s.lang.slice(0, 2).toLowerCase(),
    default: s.lang.toLowerCase().includes("english"),
  })) || [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{playerTitle}</title>

    <link rel="stylesheet" href="https://cdn.vidstack.io/player.css" />
    <link rel="stylesheet" href="https://cdn.vidstack.io/plyr.css" />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        background: #000;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: white;
        overflow: hidden;
        width: 100vw;
        height: 100vh;
      }

      .player-container {
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
      }

      #player-target {
        width: 100%;
        height: 100%;
      }

      media-player {
        width: 100%;
        height: 100%;
        --plyr-color-main: #00b3ff;
        --plyr-video-background: #000;
      }

      .error {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(255, 68, 68, 0.95);
        color: white;
        padding: 30px 40px;
        border-radius: 12px;
        max-width: 500px;
        text-align: center;
        font-size: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        z-index: 9999;
      }

      .error-title {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 10px;
      }

      .loading {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1000;
      }

      .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid rgba(255, 255, 255, 0.1);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
      }

      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      @media (max-width: 768px) {
        .error {
          padding: 20px 30px;
          font-size: 14px;
          max-width: 90%;
        }
      }
    </style>
  </head>
  <body>
    <div class="player-container">
      <div id="player-target"></div>
      <div id="loading" class="loading">
        <div class="spinner"></div>
      </div>
      <div id="error-message" class="error" style="display:none;">
        <div class="error-title">Playback Error</div>
        <div id="error-text"></div>
      </div>
    </div>

    <script
      type="module"
      define:vars={{ playerSrc, playerTitle, playerPoster, playerTracks }}
    >
      import {
        VidstackPlayer,
        PlyrLayout,
      } from "https://cdn.vidstack.io/player";

      let playerInstance = null;
      let isPlayerReady = false;

      async function initPlayer() {
        const errorEl = document.getElementById("error-message");
        const errorText = document.getElementById("error-text");
        const loadingEl = document.getElementById("loading");

        if (!playerSrc) {
          errorText.textContent =
            "No video source available. Please try again later.";
          errorEl.style.display = "block";
          loadingEl.style.display = "none";
          return;
        }

        try {
          const player = await VidstackPlayer.create({
            target: "#player-target",
            title: playerTitle,
            src: playerSrc,
            poster: playerPoster,
            crossOrigin: true,
            playsInline: true,
            layout: new PlyrLayout({
              clickToPlay: true,
              displayDuration: true,
              invertTime: true,
              seekTime: 10,
              speed: [0.5, 0.75, 1, 1.25, 1.5, 1.75, 2],
            }),
          });

          playerInstance = player;

          player.addEventListener("can-play", () => {
            isPlayerReady = true;
            loadingEl.style.display = "none";
          });

          player.addEventListener("play", async () => {
            try {
              const mediaPlayerEl = document.querySelector("media-player");
              if (mediaPlayerEl && !document.fullscreenElement) {
                await mediaPlayerEl.requestFullscreen();
              }
            } catch (error) {}
          });

          if (playerTracks && playerTracks.length > 0) {
            playerTracks.forEach((track) => {
              try {
                player.textTracks.add(track);
              } catch (e) {}
            });
          }

          player.addEventListener("error", (event) => {
            loadingEl.style.display = "none";
            errorText.textContent =
              event.detail?.message ||
              "Unable to load video. Please check your connection.";
            errorEl.style.display = "block";
          });

          player.addEventListener("loaded-data", () => {
            loadingEl.style.display = "none";
          });
        } catch (error) {
          loadingEl.style.display = "none";
          errorText.textContent = `Failed to initialize player: ${error.message}`;
          errorEl.style.display = "block";
        }
      }

      async function safePlay() {
        if (!playerInstance) {
          return;
        }

        try {
          if (playerInstance.paused) {
            await playerInstance.play();
          } else {
            playerInstance.pause();
          }
        } catch (error) {}
      }

      function safeSeek(delta) {
        if (!playerInstance || !isPlayerReady) {
          return;
        }

        try {
          const newTime = playerInstance.currentTime + delta;
          playerInstance.currentTime = Math.max(
            0,
            Math.min(playerInstance.duration || 0, newTime),
          );
        } catch (error) {}
      }

      function safeVolumeChange(delta) {
        if (!playerInstance) {
          return;
        }

        try {
          playerInstance.volume = Math.max(
            0,
            Math.min(1, playerInstance.volume + delta),
          );
        } catch (error) {}
      }

      document.addEventListener("keydown", (e) => {
        if (!playerInstance) return;

        switch (e.key) {
          case "f":
          case "F":
            try {
              if (document.fullscreenElement) {
                document.exitFullscreen();
              } else {
                document.querySelector("media-player")?.requestFullscreen();
              }
            } catch (error) {}
            break;

          case " ":
            e.preventDefault();
            safePlay();
            break;

          case "m":
          case "M":
            try {
              playerInstance.muted = !playerInstance.muted;
            } catch (error) {}
            break;

          case "ArrowLeft":
            e.preventDefault();
            safeSeek(-10);
            break;

          case "ArrowRight":
            e.preventDefault();
            safeSeek(10);
            break;

          case "ArrowUp":
            e.preventDefault();
            safeVolumeChange(0.1);
            break;

          case "ArrowDown":
            e.preventDefault();
            safeVolumeChange(-0.1);
            break;
        }
      });

      initPlayer();
    </script>
  </body>
</html>
