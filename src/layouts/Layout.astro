---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        background-color: #0f1115; /* Deep premium background */
        color: white;
        font-family: 'Inter', system-ui, sans-serif;
		left: 50%;
		transform: translateX(-50%);
		position: relative;
    }

    body {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* Standard container for all content */
    main {
        width: 100%;
        max-width: 1366px;
    }
</style>
